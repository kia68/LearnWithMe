{
  "name": "@learnwithme/api-client",
  "version": "0.0.1",
  "private": true,
  "description": "Generierter TypeScript-Client aus dem Backend-OpenAPI (ADR-011) — gemeinsam von web/ und extension/ genutzt.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts",
    "refresh": "node ../../scripts/generate-api-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
